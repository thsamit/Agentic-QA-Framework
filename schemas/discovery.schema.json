{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Discovery",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "elements"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "locator", "strategy", "validated"],
              "properties": {
                "name": {"type": "string"},
                "locator": {"type": "string"},
                "strategy": {"type": "string"},
                "validated": {"type": "boolean"},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}